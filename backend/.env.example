# Project Settings
PROJECT_NAME="Distributed Job Scheduler"
ENVIRONMENT=development

# Database Settings
# Note: Use postgres+asyncpg for async connection in code
DATABASE_URL=postgresql+asyncpg://djs_admin:djs_password@localhost:5432/djs_db

# Redis Settings
REDIS_URL=redis://localhost:6379/0

# Security and JWT Settings
# Run openssl rand -hex 32 to generate a secure secret key
SECRET_KEY=super_secret_jwt_key_at_least_32_characters_long_for_security
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
